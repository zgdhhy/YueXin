# 数据目录（SQLite、论文图片、视频、音乐）
DATA_DIR=./data
# 后台登录密码 & 会话加密密钥（至少 32 字符）
ADMIN_PASSWORD=change-me
SESSION_SECRET=please-change-this-to-a-long-random-string-32+
# Hugging Face 地址；国内本地开发可用 https://hf-mirror.com
HF_ENDPOINT=https://huggingface.co
# 可选：出网代理
# HTTPS_PROXY=http://127.0.0.1:7890
# 站点公开地址（通知里的链接用）
SITE_URL=http://localhost:3000
# 邮件渠道的默认发信服务器（可选；也可在后台通知渠道里填写）
# SMTP_HOST=smtp.example.com
# SMTP_PORT=465
# SMTP_USER=bot@example.com
# SMTP_PASS=
# SMTP_FROM=AI 论文精读 <bot@example.com>
