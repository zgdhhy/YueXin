{
  "name": "paper-web",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:web": "npm run dev -w @paper/web",
    "dev:worker": "npm run dev -w @paper/worker",
    "run-once": "npm run run-once -w @paper/worker --",
    "db:generate": "npm run db:generate -w @paper/core",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm test --workspaces --if-present",
    "check": "npm run typecheck && npm test",
    "check:reader": "node --import tsx scripts/check-reader-panel.ts"
  },
  "engines": {
    "node": ">=22"
  },
  "allowScripts": {
    "better-sqlite3": false,
    "esbuild": true
  },
  "overrides": {
    "katex": "^0.19.0"
  }
}
